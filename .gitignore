# Dependencies
**/node_modules
.pnpm-store/

# npm lockfile — project uses pnpm (packageManager: pnpm@10.4.1); pnpm-lock.yaml
# is authoritative. Prevent accidental reintroduction of a stale package-lock.json.
/package-lock.json

# Build outputs
dist/
build/
*.dist

# Deploy script artefacts (schema snapshots + previous-dist tarballs)
.deploy-backups/
deploy.log

# Environment variables
# .env.test is intentionally NOT listed here — per Decision 45 it is committed
# to the repo with test-only values (see .env.test). Per-machine test overrides
# belong in .env.test.local (ignored below).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

