# ══════════════════════════════════════════════════════════════════════════════
# MergeTasks — Environment Variables
# Copy this file to .env and fill in all values before deploying.
#
# Variables marked [REQUIRED] must be set or the server will refuse to start.
# Variables marked [REQUIRED IN PROD] are enforced only when NODE_ENV=production.
# Variables marked [OPTIONAL] enable additional features when set.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
VITE_APP_ID=mergetasks                          # [REQUIRED] App identifier
PORT=3000                                        # [OPTIONAL] Server port (default: 3000)

# Your public domain (used in email links, Stripe redirects, OAuth callbacks)
APP_BASE_URL=https://app.yourdomain.com          # [REQUIRED]
APP_URL=https://app.yourdomain.com               # [REQUIRED]

# Allowed CORS origins (comma-separated if multiple)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] MySQL connection string
DATABASE_URL=mysql://user:password@localhost:3306/mergetasks

# ── Auth ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Secret for signing JWT session tokens (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET is the primary name; JWT_SECRET is accepted as a legacy fallback.
SESSION_SECRET=your-session-secret-min-32-chars

# [REQUIRED] AES-256 key for encrypting OAuth tokens and SMTP passwords at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=your-credential-encryption-key-min-32-chars

# [OPTIONAL] Owner account OpenID (set after first login — check the users table)
OWNER_OPEN_ID=your-owner-id

# ── Stripe (MergeTasks subscription billing + store payments) ───────────────────
#
# IMPORTANT: Use separate keys for test and production environments.
# The server will HARD FAIL at startup if a test key (sk_test_...) is found
# in a NODE_ENV=production deployment, or if the key prefix is unrecognized.
#
# Deployment pipeline recommendation:
#   - Store STRIPE_SECRET_KEY_TEST and STRIPE_SECRET_KEY_LIVE as separate
#     secrets in your CI/CD system (GitHub Actions, Railway, Render, etc.)
#   - Set STRIPE_SECRET_KEY = $STRIPE_SECRET_KEY_LIVE in your production
#     environment, and STRIPE_SECRET_KEY = $STRIPE_SECRET_KEY_TEST in staging.
#   - Never commit either key to source control.
#
# Get keys from: https://dashboard.stripe.com/apikeys
# Get webhook secret from: https://dashboard.stripe.com/webhooks
#
# [OPTIONAL] Set to sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
# [OPTIONAL] Webhook signing secret — must start with whsec_
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key for client-side Stripe.js (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Platform fee percentage charged to distributors on workstore transactions
STRIPE_PLATFORM_FEE_PERCENT=2
# Subscription price IDs (created via scripts/create-stripe-prices.mjs)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# ── Resend (Transactional Email — 2FA codes, proposals, invites) ─────────────
# [REQUIRED FOR LOGIN] Without Resend, users cannot receive verification codes
# and login will fail. Verify email delivery works before launching.
# Get from resend.com dashboard
RESEND_API_KEY=re_...

# Distributor-provided SMTP (Gmail/Outlook/custom) for proposal/client emails
# is configured per-user in Settings → Email Connections and is independent of
# the platform Resend key above.

# ── OpenAI (AI Copilot, AI Insights, Voice, Image Generation) ─────────────────
# [REQUIRED] Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# [OPTIONAL] Separate key for app-level AI features (falls back to OPENAI_API_KEY)
APP_OPENAI_API_KEY=sk-...

# ── Redis (BullMQ queues, rate limiter, token blocklist, PKCE store) ─────────
# [REQUIRED] Per Decision 27, Redis is the shared backbone for:
#   - BullMQ async queues (agent tools, Phase 8)
#   - Persistent rate limiting across deploys (PCI DSS Req 8.1.7)
#   - Token blocklist (logout-all-devices, emergency session revocation)
#   - OIDC PKCE verifier store
# Use rediss:// (two s's) to enable TLS — required by AWS ElastiCache in-transit encryption.
REDIS_URL=rediss://master.mergetasks-redis-prod.1nj6ek.use1.cache.amazonaws.com:6379

# ── Google OAuth (optional — for Gmail send integration + social login) ───────
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://app.yourdomain.com/api/email/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Microsoft OAuth (optional — for Outlook send integration + social login) ──
# Get from: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Authorized redirect URI: https://app.yourdomain.com/api/email/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ── S3 File Storage (optional — for uploaded logos and images) ────────────────
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your-secret

# ── PromoStandards Supplier APIs (optional) ───────────────────────────────────
# SanMar
PS_SANMAR_USERNAME=
PS_SANMAR_PASSWORD=
# Alphabroder
PS_ALPHABRODER_USERNAME=
PS_ALPHABRODER_PASSWORD=
# S&S Activewear
PS_SS_USERNAME=
PS_SS_PASSWORD=

# ── SanMar Canada Bulk Data SOAP API (optional) ──────────────────────────────
# Endpoint: https://edi.atc-apparel.com/bulk-data/BulkDataService.php
# Rate-limited to ONE call per day per credential — pulled by the nightly
# agent cron and used to upsert products for any org with a SanMar supplier.
SANMAR_ACCOUNT_ID=
SANMAR_PASSWORD=

# ── ASI Product Search (optional) ────────────────────────────────────────────
ASI_ACCOUNT_ID=
ASI_API_KEY=

# ── TLS / HTTPS (PCI DSS Req 4.1) ────────────────────────────────────────────
# If running HTTPS directly (no reverse proxy), provide cert paths:
# TLS_CERT_PATH=/etc/ssl/certs/mergetasks.crt
# TLS_KEY_PATH=/etc/ssl/private/mergetasks.key

# ── Database SSL (PCI DSS Req 4.1) ───────────────────────────────────────────
# TLS is enabled by default for TCP database connections.
# DB_SSL=false                          # Set to false only for local dev with Unix sockets
# DB_SSL_REJECT_UNAUTHORIZED=true       # Set to false only for self-signed certs in staging
# DB_SSL_CA=/path/to/ca-cert.pem        # Custom CA certificate (optional)

# ── Error Monitoring (optional) ───────────────────────────────────────────────
# Get from: https://sentry.io
SENTRY_DSN=
# Client-side Sentry DSN (exposed to browser — use a separate project if desired)
VITE_SENTRY_DSN=

# ── Deploy webhook (optional — required to enable auto-deploy on git push) ──
# Shared secret configured on both sides of the GitHub webhook:
#   GitHub repo → Settings → Webhooks → content-type: application/json
#   Payload URL: https://<your-host>/api/deploy/webhook
#   Secret: same value as DEPLOY_WEBHOOK_SECRET
# Leave blank to disable the endpoint entirely (it returns 503 when unset).
DEPLOY_WEBHOOK_SECRET=
