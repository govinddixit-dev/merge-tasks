# ══════════════════════════════════════════════════════════════════════════════
# MergeTasks — Test Environment Variables (Decision 45)
#
# This file is COMMITTED to the repo and contains ONLY safe test-only values.
# Real secrets (prod DB URL, prod Stripe keys, prod Resend keys) live in
# GitHub Actions secrets for CI and in .env / .env.production / .env.local
# on developer machines — all gitignored.
#
# Values here mirror `.github/workflows/ci.yml` so `vitest run` and
# `playwright test` behave identically locally and in CI, provided the
# developer has MySQL on :3306 and Redis on :6379 (see README).
#
# Per-machine overrides belong in .env.test.local (gitignored).
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=test
CI=false

# ── Database (containerized MySQL 8.0 per Decision 42) ────────────────────────
# Expected local setup: docker run -p 3306:3306 ... mysql:8.0 with schema
# `mergetasks_test` and user `mergetasks / mergetasks_pass`.
DATABASE_URL=mysql://mergetasks:mergetasks_pass@127.0.0.1:3306/mergetasks_test?ssl=false
DB_SSL=false

# ── Redis (Decision 27; Task 1b consumer migration) ───────────────────────────
# Expected local setup: docker run -p 6379:6379 redis:7-alpine (no TLS for tests).
REDIS_URL=redis://127.0.0.1:6379

# ── App / auth ────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5000
SESSION_SECRET=test-session-secret-minimum-32-chars-long
CREDENTIAL_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# ── Third-party keys (all test-only, never call real APIs in tests) ───────────
# Stripe test keys — validateEnv.ts's prefix check accepts sk_test_* / pk_test_*.
STRIPE_SECRET_KEY=sk_test_not_a_real_key_safe_for_ci
STRIPE_WEBHOOK_SECRET=whsec_test_not_a_real_secret_safe_for_ci
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_not_a_real_key_safe_for_ci
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_not_a_real_key_safe_for_ci

# OpenAI + Resend — mock sentinels. No test makes real network calls.
OPENAI_API_KEY=test-openai-key-not-used-in-ci
RESEND_API_KEY=test-resend-key-not-used-in-ci
